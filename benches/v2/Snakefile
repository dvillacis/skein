# Real-dataset case studies — produced by the standalone run_realdata
# driver (not orchestrated by snakemake since the cell shape is
# different and there's only ~10 cells total).

REALDATA_RESULTS = sorted(
    str(p) for p in (RESULTS / "realdata").glob("*.jsonl")
) if (RESULTS / "realdata").exists() else []


rule figure_realdata:
    input:
        REALDATA_RESULTS,
    output:
        PAPER / "figures" / "F6_realdata_boxplots.pdf",
    shell:
        "PYTHONPATH={proj_root} {sys.executable} -m benches.v2.report.figures realdata_boxplots "
        "--inputs {input} --out {output}"


rule table_realdata:
    input:
        REALDATA_RESULTS,
    output:
        PAPER / "tables" / "T5_realdata.tex",
    shell:
        "PYTHONPATH={proj_root} {sys.executable} -m benches.v2.report.tables realdata "
        "--inputs {input} --out {output}"


