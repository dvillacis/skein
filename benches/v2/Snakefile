rule paper_bundle:
    """Materialize paper/manifest.json + paper/BUNDLE.md from whatever
    figures/tables exist. Does NOT run drivers — pair with `all` to
    fully populate first."""
    input:
        # All artifacts expected by the bundle script. If any are
        # missing the script reports them (and exits 1 if --strict).
        PAPER / "figures" / "F1_coverage_matrix.pdf",
        PAPER / "tables"  / "T1_estimator_surface.tex",
    output:
        PAPER / "manifest.json",
        PAPER / "BUNDLE.md",
    shell:
        "PYTHONPATH={proj_root} {sys.executable} -m benches.v2.report.paper_bundle "
        "--paper-dir {PAPER}"


