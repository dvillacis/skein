rule table_environment:
    """Auto-rendered from the env.json files produced alongside cells."""
    input:
        expand(str(RESULTS / "cells" /
                   "{scenario}__{size}__{regime}__seed{seed}__{package}.env.json"),
               zip,
               scenario=[c[0] for c in HEADLINE_CELLS],
               size=    [c[1] for c in HEADLINE_CELLS],
               regime=  [c[2] for c in HEADLINE_CELLS],
               seed=    [c[3] for c in HEADLINE_CELLS],
               package= [c[4] for c in HEADLINE_CELLS]),
    output:
        PAPER / "tables" / "T6_environment.tex",
    shell:
        "PYTHONPATH={proj_root} {sys.executable} -m benches.v2.report.tables environment "
        "--inputs {input} --out {output}"
